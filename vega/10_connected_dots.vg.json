{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Half of Children Who Craft Do Under 3 Hours a Week",
    "offset": 15
  },
  "data": {
    "url": "data/10_children_hours.csv"
  },
  "transform": [
    {
      "filter": "datum.activity != 'Reading for pleasure'"
    }
  ],
  "width": 580,
  "height": {
    "step": 52
  },
  "encoding": {
    "y": {
      "field": "hours_per_week",
      "type": "ordinal",
      "sort": [
        "0-2",
        "3-4",
        "5-9",
        "10-19",
        "20+"
      ],
      "title": "Hours per Week",
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 15
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 4,
        "color": "#D7D4CA"
      },
      "encoding": {
        "x": {
          "aggregate": "min",
          "field": "pct_of_children_doing_it",
          "type": "quantitative"
        },
        "x2": {
          "aggregate": "max",
          "field": "pct_of_children_doing_it"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 260,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "pct_of_children_doing_it",
          "type": "quantitative",
          "title": "% of Children Who Do the Activity",
          "scale": {
            "domain": [
              0,
              60
            ]
          }
        },
        "color": {
          "field": "activity",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Arts and crafts",
              "Screen-based activities"
            ],
            "range": [
              "#D98E04",
              "#1F06AC"
            ]
          },
          "legend": {
            "orient": "top",
            "symbolSize": 200,
            "labelLimit": 260
          }
        },
        "tooltip": [
          {
            "field": "activity",
            "title": "Activity"
          },
          {
            "field": "hours_per_week",
            "title": "Hours a Week"
          },
          {
            "field": "pct_of_children_doing_it",
            "title": "% of Children"
          },
          {
            "field": "children_thousand",
            "title": "Children (thousands)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -16,
        "fontSize": 14,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "pct_of_children_doing_it",
          "type": "quantitative"
        },
        "text": {
          "field": "pct_of_children_doing_it",
          "format": ".0f"
        },
        "color": {
          "field": "activity",
          "type": "nominal",
          "scale": {
            "domain": [
              "Arts and crafts",
              "Screen-based activities"
            ],
            "range": [
              "#D98E04",
              "#1F06AC"
            ]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "activity": "Arts and crafts",
            "hours_per_week": "0-2",
            "v": 51.1,
            "t": "peaks at 51%"
          },
          {
            "activity": "Screen-based activities",
            "hours_per_week": "10-19",
            "v": 40,
            "t": "peaks at 40%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": 20,
        "fontSize": 14,
        "fontWeight": 700,
        "color": "#2A7F9E"
      },
      "encoding": {
        "x": {
          "field": "v",
          "type": "quantitative"
        },
        "y": {
          "field": "hours_per_week",
          "type": "ordinal",
          "sort": [
            "0-2",
            "3-4",
            "5-9",
            "10-19",
            "20+"
          ]
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ]
}