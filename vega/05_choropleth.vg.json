{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Tasmania and the ACT Have the Most Creative People per Head",
    "offset": 26
  },
  "width": 1000,
  "height": 540,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ],
    "center": [
      -3,
      -30
    ],
    "scale": 840
  },
  "layer": [
    {
      "data": {
        "url": "geo/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "data/05_state_participation_rate.csv"
            },
            "key": "state",
            "fields": [
              "participation_rate_pct",
              "state_abbr",
              "participants_thousand"
            ]
          }
        },
        {
          "calculate": "datum.participation_rate_pct < 31 ? 'Under 31%' : datum.participation_rate_pct < 35 ? '31% to 35%' : 'More than 35%'",
          "as": "cls"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "cls",
          "type": "nominal",
          "title": "Adults Who Took Part in ≥1 Creative Activity",
          "sort": [
            "Under 31%",
            "31% to 35%",
            "More than 35%"
          ],
          "scale": {
            "domain": [
              "Under 31%",
              "31% to 35%",
              "More than 35%"
            ],
            "range": [
              "#D3E6DA",
              "#7DB59A",
              "#1F5C4A"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "vertical",
            "symbolType": "square",
            "symbolSize": 260,
            "offset": 2,
            "titleLimit": 260,
            "labelLimit": 220
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "State"
          },
          {
            "field": "participation_rate_pct",
            "title": "% who took part"
          },
          {
            "field": "participants_thousand",
            "title": "People (thousands)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "abbr": "NSW",
            "lon": 146.6,
            "lat": -32.4
          },
          {
            "abbr": "Vic",
            "lon": 144.2,
            "lat": -36.9
          },
          {
            "abbr": "Qld",
            "lon": 144.8,
            "lat": -22.6
          },
          {
            "abbr": "SA",
            "lon": 135.2,
            "lat": -30
          },
          {
            "abbr": "WA",
            "lon": 122,
            "lat": -25.8
          },
          {
            "abbr": "NT",
            "lon": 133.4,
            "lat": -19.4
          }
        ]
      },
      "transform": [
        {
          "lookup": "abbr",
          "from": {
            "data": {
              "url": "data/05_state_participation_rate.csv"
            },
            "key": "state_abbr",
            "fields": [
              "participation_rate_pct"
            ]
          }
        },
        {
          "calculate": "datum.abbr + ' ' + format(datum.participation_rate_pct, '.1f') + '%'",
          "as": "t"
        },
        {
          "calculate": "datum.participation_rate_pct >= 35 ? 'white' : '#1c1c1a'",
          "as": "c"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 700,
        "dx": -20
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.participation_rate_pct >= 35",
            "value": "white"
          },
          "value": "#1C1C1A"
        }
      }
    },
    {
