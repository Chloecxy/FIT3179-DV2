{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Women Rate the Benefits of Creativity Higher on Every Measure",
    "offset": 15
  },
  "width": 490,
  "height": 420,
  "layer": [
    {
      "data": {
        "sequence": {
          "start": 0,
          "stop": 8,
          "as": "idx"
        }
      },
      "transform": [
        {
          "calculate": "[20,40,60,80]",
          "as": "level"
        },
        {
          "flatten": [
            "level"
          ]
        },
        {
          "calculate": "datum.idx * 2 * PI / 8",
          "as": "ang"
        },
        {
          "calculate": "datum.level / 80 * sin(datum.ang)",
          "as": "x"
        },
        {
          "calculate": "datum.level / 80 * cos(datum.ang)",
          "as": "y"
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "linear-closed",
        "stroke": "#CFCBC0",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1.75,
              1.75
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1.5,
              1.5
            ]
          },
          "axis": null
        },
        "detail": {
          "field": "level",
          "type": "nominal"
        },
        "order": {
          "field": "idx",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "sequence": {
          "start": 0,
          "stop": 8,
          "as": "idx"
        }
      },
      "transform": [
        {
          "calculate": "datum.idx * 2 * PI / 8",
          "as": "ang"
        },
        {
          "calculate": "sin(datum.ang)",
          "as": "x"
        },
        {
          "calculate": "cos(datum.ang)",
          "as": "y"
        },
        {
          "calculate": "0",
          "as": "x0"
        },
        {
          "calculate": "0",
          "as": "y0"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#CFCBC0",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1.75,
              1.75
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1.5,
              1.5
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x"
        },
        "y2": {
          "field": "y"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "level": 20,
            "t": "20%"
          },
          {
            "level": 40,
            "t": "40%"
          },
          {
            "level": 60,
            "t": "60%"
          },
          {
            "level": 80,
            "t": "80%"
          }
        ]
      },
      "transform": [
        {
          "calculate": "datum.level / 80",
