    },
    {
      "data": {
        "url": "data/11_naps_impact_by_sex.csv",
        "format": {
          "type": "csv",
          "parse": {
            "men_pct": "number",
            "women_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.use_in_radar == true || datum.use_in_radar == 'true'"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rn"
            }
          ]
        },
        {
          "calculate": "datum.rn - 1",
          "as": "idx"
        },
        {
          "calculate": "datum.idx * 2 * PI / 8",
          "as": "ang"
        },
        {
          "calculate": "{'Shaping and expressing Australian identity':'Australian identity','Our ability to think creatively and develop new ideas':'Thinking creatively','Our ability to express ourselves':'Expressing ourselves','Our understanding of other people and cultures':'Understanding others','Child development':'Child development','Helping us deal with stress, anxiety or depression':'Dealing with stress','Our sense of wellbeing and happiness':'Wellbeing and happiness','Stimulating our minds':'Stimulating our minds'}[datum.statement]",
          "as": "lab"
        },
        {
          "fold": [
            "men_pct",
            "women_pct"
          ],
          "as": [
            "who",
            "val"
          ]
        },
        {
          "calculate": "datum.who == 'men_pct' ? 'Men' : 'Women'",
          "as": "sex"
        },
        {
          "calculate": "datum.val / 80 * sin(datum.ang)",
          "as": "x"
        },
        {
          "calculate": "datum.val / 80 * cos(datum.ang)",
          "as": "y"
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "linear-closed",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1.75,
              1.75
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1.5,
              1.5
            ]
          },
          "axis": null
        },
        "order": {
          "field": "idx",
          "type": "quantitative"
        },
        "color": {
          "field": "sex",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Men",
              "Women"
            ],
            "range": [
              "#4A86C5",
              "#D8639A"
            ]
          },
          "legend": {
            "orient": "top",
            "symbolType": "square"
          }
        },
        "tooltip": [
          {
            "field": "lab",
            "title": "Area"
          },
          {
            "field": "sex",
            "title": "Who"
          },
          {
            "field": "val",
            "title": "% Saying Big Impact"
