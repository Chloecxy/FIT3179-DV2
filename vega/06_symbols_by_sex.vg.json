            "stroke": "white",
            "strokeWidth": 1.5
          },
          "encoding": {
            "longitude": {
              "field": "capital_lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "capital_lat",
              "type": "quantitative"
            },
            "size": {
              "field": "pct_of_participants_doing_3plus_types",
              "type": "quantitative",
              "title": [
                "Of those, share doing",
                "3+ kinds of activity (%)"
              ],
              "scale": {
                "domain": [
                  0,
                  30
                ],
                "range": [
                  0,
                  1700
                ]
              },
              "legend": {
                "orient": "top",
                "direction": "horizontal",
                "values": [
                  10,
                  20,
                  30
                ],
                "symbolFillColor": "#B9B5AB",
                "symbolStrokeColor": "white",
                "offset": 24,
                "labelExpr": "datum.value === 10 ? 'Under 10%' : datum.value === 20 ? '10% to 20%' : '20% to 30%'"
              }
            },
            "color": {
              "field": "cls",
              "type": "nominal",
              "title": "Women who took part",
              "sort": [
                "Under 25%",
                "25% to 35%",
                "35% to 45%",
                "45% or more"
              ],
              "scale": {
                "domain": [
