                  "35% to 45%",
                  "45% or more"
                ],
                "range": [
                  "#FBDCE8",
                  "#F4A9C8",
                  "#E0689B",
                  "#B0286A"
                ]
              },
              "legend": {
                "orient": "top",
                "direction": "vertical",
                "symbolType": "circle",
                "symbolSize": 160,
                "offset": 0,
                "labelLimit": 200
              }
            },
            "order": {
              "field": "capital_lat",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "state",
                "title": "State"
              },
              {
                "field": "participation_rate_pct",
                "title": "% who took part"
              },
              {
                "field": "pct_of_participants_doing_3plus_types",
                "title": "% doing 3+ kinds"
              }
            ]
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent",
      "size": "shared"
    },
    "legend": {
      "color": "independent",
      "size": "shared"
    }
  }
}