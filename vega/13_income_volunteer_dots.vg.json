            "Film-making and editing",
            "Designing websites and games",
            "Photography",
            "Acting and performing",
            "Singing or playing an instrument",
            "Writing stories, poetry or blogs",
            "Songwriting and making music",
            "Dancing",
            "Painting, drawing and sculpting",
            "Craft"
          ],
          "title": null,
          "axis": {
            "labelLimit": 340,
            "domain": false,
            "ticks": false,
            "labelFontSize": 12
          }
        },
        "x": {
          "value": 0
        },
        "x2": {
          "value": 850
        }
      }
    },
    {
