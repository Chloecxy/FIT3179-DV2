            "labelLimit": 340,
            "domain": false,
            "ticks": false,
            "labelFontSize": 12
          }
        },
        "x": {
          "aggregate": "min",
          "field": "pct_of_participants",
          "type": "quantitative"
        },
        "x2": {
          "aggregate": "max",
          "field": "pct_of_participants"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 170,
        "opacity": 1
