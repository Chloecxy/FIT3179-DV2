{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Of 11 Activities, Craft Is the Least Likely to Earn Money",
    "offset": 15
  },
  "data": {
    "url": "data/09_income_volunteer.csv"
  },
  "transform": [
    {
      "calculate": "datum.measure == 'Received income' ? 'Earned money from it' : 'Volunteered'",
      "as": "what"
    }
  ],
  "width": 850,
  "height": {
    "step": 32
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.activity == 'Craft'"
        }
      ],
