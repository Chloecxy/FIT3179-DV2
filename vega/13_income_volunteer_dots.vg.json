    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "pct_of_participants",
              "as": "hi"
            }
          ],
          "groupby": [
            "activity"
          ]
        },
        {
          "filter": "datum.pct_of_participants != datum.hi"
