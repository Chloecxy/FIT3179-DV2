          {
            "field": "what",
            "title": "Measure"
          },
          {
            "field": "pct_of_participants",
            "title": "% of Participants",
            "format": ".1f"
          },
          {
            "field": "participants_thousand",
            "title": "People (thousands)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "pct_of_participants",
              "as": "hi"
            }
          ],
          "groupby": [
            "activity"
          ]
