{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "params": [
    {
      "name": "map_view",
      "value": "AU",
      "bind": {
        "input": "select",
        "options": [
          "AU",
          "SE",
          "NSW",
          "VIC",
          "QLD",
          "WA",
          "SA",
          "TAS",
          "NT"
        ],
        "labels": [
          "All of Australia",
          "South-east",
          "New South Wales",
          "Victoria",
          "Queensland",
          "Western Australia",
          "South Australia",
          "Tasmania",
          "Northern Territory"
        ],
        "name": "Map view "
      }
    },
    {
      "name": "view_centers",
      "value": {
        "AU": [-0.82, -27.2],
        "SE": [13.92, -35.93],
        "NSW": [13.71, -33.1],
        "VIC": [11.31, -36.48],
        "QLD": [11.14, -19.88],
        "WA": [-12.75, -24.42],
        "SA": [1.06, -32.1],
        "TAS": [12.31, -41.53],
        "NT": [-0.54, -18.61]
      }
    },
    {
      "name": "fit_scales",
      "value": {
        "AU": 660,
        "SE": 1500,
        "NSW": 2420,
        "VIC": 4080,
        "QLD": 1120,
        "WA": 1000,
        "SA": 1810,
        "TAS": 5400,
        "NT": 1480
      }
    },
    {
      "name": "zoom_factor",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 0.7,
        "max": 2.5,
        "step": 0.1,
        "name": "Zoom x "
      }
    }
  ],
  "vconcat": [
    {
      "title": {
        "text": "Where Do They Get Their Supplies?",
        "subtitle": "Drag across the bars to filter the map to those states",
        "subtitleFontSize": 13,
        "offset": 15
      },
      "data": {
        "url": "data/07_craft_shops.csv"
      },
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "state"
          ]
        }
      ],
      "params": [
        {
          "name": "state_sel",
          "select": {
            "type": "interval",
            "encodings": [
              "x"
            ]
          }
        }
      ],
      "width": 580,
      "height": 120,
      "mark": {
        "type": "bar",
        "tooltip": true,
        "cursor": "ew-resize",
        "fill": "#D96868"
      },
      "encoding": {
        "x": {
          "field": "state",
          "type": "ordinal",
          "title": "State",
          "sort": "-y",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "n",
          "type": "quantitative",
          "title": "Mapped Shops",
          "axis": {
            "orient": "right"
          }
        },
        "opacity": {
          "condition": {
            "param": "state_sel",
            "value": 1
          },
          "value": 0.4
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "n",
            "title": "Shops"
          }
        ]
      }
    },
    {
      "title": {
        "text": "Where The Supply Shops Are?",
        "offset": 30
      },
      "width": 580,
      "height": 440,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -134,
          0
        ],
        "center": {
          "expr": "view_centers[map_view]"
        },
        "translate": [
          290,
          220
        ],
        "scale": {
          "expr": "fit_scales[map_view] * zoom_factor"
        }
      },
      "layer": [
        {
          "data": {
            "url": "geo/australia_states.topojson",
            "format": {
              "type": "topojson",
              "feature": "states"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#ECEAE2",
            "stroke": "white",
            "strokeWidth": 1
          }
        },
        {
          "data": {
            "url": "data/07_craft_shops.csv"
          },
          "transform": [
            {
              "filter": {
                "param": "state_sel"
              }
            },
            {
              "filter": {
                "param": "group_sel"
              }
            }
          ],
          "mark": {
            "type": "circle",
            "size": 40,
            "opacity": 0.7,
            "stroke": "white",
            "strokeWidth": 0.3
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "color": {
              "field": "group",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Craft and art supplies",
                  "Fabric, sewing and yarn"
                ],
                "range": [
                  "#D98E04",
                  "#9564DD"
                ]
              },
              "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "symbolType": "circle",
                "symbolSize": 80,
                "labelLimit": 260
              }
            },
            "tooltip": [
              {
                "field": "name",
                "title": "Shop"
              },
              {
                "field": "group",
                "title": "Type"
              },
              {
                "field": "state",
                "title": "State"
              }
            ]
          },
          "params": [
            {
              "name": "group_sel",
              "select": {
                "type": "point",
                "fields": [
                  "group"
                ]
              },
              "bind": "legend"
            }
          ]
        }
      ]
    }
  ],
  "spacing": 50,
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}
